visaoraworld.com, www.visaoraworld.com {
    root * /srv

    handle /api/* {
        uri strip_prefix /api
        reverse_proxy backend-api:3001
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}

:80 {
    root * /srv

    handle /api/* {
        uri strip_prefix /api
        reverse_proxy backend-api:3001
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}
