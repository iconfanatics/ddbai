visaoraworld.com, www.visaoraworld.com {
    root * /srv


    handle /api/* {
        uri strip_prefix /api
        reverse_proxy 172.17.0.1:3001
    }

    handle /minio-api/* {
        uri strip_prefix /minio-api
        reverse_proxy minio:9000
    }


    handle {
        try_files {path} /index.html
        file_server
    }
}

:80 {
    root * /srv


    handle /api/* {
        uri strip_prefix /api
        reverse_proxy 172.17.0.1:3001
    }

    handle /minio-api/* {
        uri strip_prefix /minio-api
        reverse_proxy minio:9000
    }


    handle {
        try_files {path} /index.html
        file_server
    }
}
