# VisaSync Production Environment Variables

# Database
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_NAME=visasync_prod
DATABASE_URL=postgresql://postgres:your_secure_db_password@db:5432/visasync_prod?schema=public

# Authentication
JWT_SECRET=your_secure_jwt_secret_key
JWT_EXPIRES_IN=1d

# MinIO / Object Storage (S3 Compatible)
MINIO_ROOT_USER=prodadmin
MINIO_ROOT_PASSWORD=your_secure_minio_password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false

# Node Environment
NODE_ENV=production
PORT=3001

# External APIs (e.g., Stripe, Twilio) - Placeholders
STRIPE_SECRET_KEY=sk_test_...
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
